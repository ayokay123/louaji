# .env.example — Louaji environment variables reference
#
# Copy this file to .env and fill in real values for local development.
# .env is gitignored; .env.example is the canonical list of required keys.
#
# Prefix convention:
#   EXPO_PUBLIC_*   → bundled into the client (safe for public values only)
#   anything else   → server-only (API routes / Edge Functions)
#
# NEVER put a secret behind EXPO_PUBLIC_ — it will end up in the browser bundle.

# ─── Supabase ──────────────────────────────────────────────────────────────
# Run `pnpm db:start` (a.k.a. `supabase start`) and then `supabase status` to
# get the values printed for a fresh local stack. The URL and anon key are
# safe on the client; the service-role key must stay server-side only.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── SMS / OTP (Twilio Verify) ─────────────────────────────────────────────
# Phone-first auth (signup/login OTP) + booking-confirmation SMS. Server-only.
# Configure the matching SMS provider in Supabase Auth → Phone settings too.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Sender number (or Messaging Service SID) for transactional SMS (booking
# confirmation / trip cancellation). Leave blank locally — SMS becomes a no-op.
TWILIO_FROM=

# ─── Supabase CLI / CI (optional, ops only) ────────────────────────────────
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=

# ─── FUTURE (not used in v1) ───────────────────────────────────────────────
# Online payment via a Tunisian gateway (Flouci / Konnect / ClicToPay) and
# maps/live-tracking keys are added when those features are built. v1 is
# cash-on-boarding only and has no maps. See docs/TECHNOLOGIES.md.
